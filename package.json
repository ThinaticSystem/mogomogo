	},
	"dependencies": {
		"cloudflare": "^6.0.0"
	},
	"devDependencies": {
		"@types/node": "24 - 24.16",
		"@typescript/native-preview": "7.0.0-dev.20260517.1",
		"oxfmt": "^0.50.0",
		"oxlint": "^1.42.0",
		"oxlint-tsgolint": "^0.22.0",
		"vitest": "^4.0.18"
	},
	"packageManager": "pnpm@11.3.0"
}
